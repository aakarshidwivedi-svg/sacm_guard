# Optional. Without a key the rule-based analyzer is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
PORT=3001
DATABASE_URL=          # optional; enables accounts + history (Supabase/Postgres)
PGSSL=                 # set to "disable" for local Postgres
AUTH_SECRET=           # 32+ random chars; required with DATABASE_URL
SAFE_BROWSING_API_KEY= # optional; sends URLs to Google Safe Browsing
CORS_ORIGIN=http://localhost:5173
